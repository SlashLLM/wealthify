# Local testing against Supabase running in Docker (npm run db:start).
# Used by: npm run dev:test  — this file is loaded INSTEAD of .env, never merged with it.

# Local Supabase (from `npm run db:status`). These are the standard local demo keys;
# they only work against the container on this machine.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Admin panel (http://localhost:3000/admin)
ADMIN_PASSWORD=wealthify-test
ADMIN_SESSION_SECRET=any-random-32-char-string-for-local-tests
ADMIN_EMAIL=admin-test@example.com

# Emails are printed to the dev-server console instead of being sent.
EMAIL_MODE=log
RESEND_FROM=Wealthify Test <test@example.com>

# Address autocomplete (browser key, referrer-restricted). Optional.
GOOGLE_PLACES_API_KEY=
